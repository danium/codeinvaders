{
  "name": "@codeinvaders/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "codeinvaders": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@codeinvaders/adapter-claude": "workspace:*",
    "@codeinvaders/adapter-codex": "workspace:*",
    "@codeinvaders/core": "workspace:*",
    "@codeinvaders/protocol": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  }
}
