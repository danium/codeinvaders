{
  "name": "codeinvaders",
  "version": "0.1.0",
  "private": true,
  "description": "A local observability arcade for coding-agent sessions.",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.27.0 <11"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @codeinvaders/local dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present build && pnpm -r --if-present typecheck",
    "test": "vitest run --config vitest.config.mjs",
    "protocol:docs:check": "pnpm --filter @codeinvaders/protocol build && node scripts/check-protocol-compatibility-docs.mjs",
    "protocol:docs:generate": "pnpm --filter @codeinvaders/protocol build && node scripts/check-protocol-compatibility-docs.mjs --write",
    "third-party-notices:generate": "node scripts/generate-third-party-notices.mjs",
    "third-party-notices:check": "node scripts/generate-third-party-notices.mjs --check",
    "offline:audit": "node scripts/security-audit.mjs --json",
    "release:test": "node scripts/release/release-scripts.test.mjs",
    "release:verify": "node scripts/release/verify-release.mjs",
    "release:prepare": "node scripts/release/prepare-release.mjs",
    "check": "pnpm release:test && pnpm third-party-notices:check && pnpm offline:audit && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm offline:audit && node scripts/check-protocol-compatibility-docs.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
